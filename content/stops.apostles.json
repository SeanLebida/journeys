 {
  "id": "stop-philip-apostle-hierapolis",
  "journeyId": "journey-philip-apostle",
  "order": 1,
  "siteId": "site-hierapolis",
  "legMode": "land",
  "dateRange": {
   "startYear": 80,
   "endYear": 80,
   "display": {
    "en": "Later, c. AD 80, the tradition of his burial"
   },
   "approximate": true
  },
  "eventSummary": {
   "en": "Eusebius quotes Polycrates of Ephesus: Philip, one of the Twelve, sleeps at Hierapolis. Proclus, whom Eusebius also quotes, puts a tomb of Philip and his daughters there, and Eusebius notes that Acts' Philip at Caesarea is the evangelist."
  },
  "scriptureRefs": [],
  "persons": [
   "person-philip-apostle"
  ],
  "confidence": "legendary",
  "reviewStatus": "self-reviewed",
  "disputes": {
   "en": "Polycrates calls the Philip at Hierapolis one of the Twelve. Luke's Philip with four prophesying daughters is the evangelist at Caesarea. Eusebius sets the two notices side by side. This stop follows Polycrates and does not use Acts 8."
  },
  "citations": [
   "cit-src-eusebius-he",
   "cit-ref-keener-bbcnt"
  ]
