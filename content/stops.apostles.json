   },
   "approximate": true
  },
  "eventSummary": {
   "en": "Eusebius preserves the tradition that John lived at Ephesus. Acts does not send him there."
  },
  "scriptureRefs": [],
  "persons": [
   "person-john-apostle"
  ],
  "confidence": "legendary",
  "reviewStatus": "self-reviewed",
  "disputes": {
   "en": "The New Testament does not place the apostle at Ephesus. The tradition comes through second-century writers as Eusebius reports them."
  },
