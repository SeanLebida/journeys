   "startYear": 95,
   "endYear": 95,
   "display": {
    "en": "c. AD 95, the island"
   },
   "approximate": true
  },
  "eventSummary": {
   "en": "Revelation says John was on the island of Patmos because of the word of God. Whether that John is the apostle is disputed."
  },
  "scriptureRefs": [
   "Revelation 1:9"
  ],
  "persons": [
   "person-john-apostle"
  ],
  "confidence": "disputed",
  "reviewStatus": "self-reviewed",
  "disputes": {
   "en": "Revelation 1:9 names John on Patmos and does not call him the son of Zebedee. Early tradition identifies them. Some scholars do not."
  },
