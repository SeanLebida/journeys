 {
  "id": "stop-andrew-scythia",
  "journeyId": "journey-andrew",
  "order": 1,
  "siteId": "site-olbia-pontica",
  "legMode": "sea",
  "dateRange": {
   "startYear": 50,
   "endYear": 59,
   "display": {
    "en": "Earlier, c. AD 50, the tradition of Scythia"
   },
   "approximate": true
  },
  "eventSummary": {
   "en": "Eusebius, citing Origen, says Scythia was allotted to Andrew. The pin is Pontic Olbia, a Greek city on that shore, because the text names a region and not a town."
  },
  "scriptureRefs": [],
  "persons": [
   "person-andrew"
  ],
  "confidence": "legendary",
  "reviewStatus": "self-reviewed",
  "disputes": {
   "en": "Acts does not send Andrew to Scythia. Eusebius reports a tradition and names no city. Olbia is a real Black Sea coordinate in that region, not a place the ancient notice identifies."
  },
  "citations": [
   "cit-src-eusebius-he",
   "cit-ref-keener-bbcnt"
  ]
 },
 {
