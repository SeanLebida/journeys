{
  "name": "journeys-bible-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that proxies the YouVersion Platform API for NASB 1995 and NASB 2020 in the Journeys app.",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "eslint .",
    "types": "wrangler types",
    "dry-run": "wrangler deploy --dry-run",
    "dry-run:staging": "wrangler deploy --dry-run --env staging"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "wrangler": "4.156.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
