{
  // Separate file so staging cannot inherit the production path route.
  // workers.dev only. Do not add routes, custom domains, or DNS.
  "name": "journeys-web-staging",
  "account_id": "1a27e1439dde2fa5249a1fe07b43b3f4",
  "compatibility_date": "2026-11-14",
  "main": "src/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../../dist",
    "base_path": "/app",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/app/assets/*"]
  }
}
