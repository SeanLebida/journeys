{
  // Path route only. The rest of journeys.authentic.how stays on the origin.
  // Missing /app/assets/* must return 404 (not the SPA shell). App routes still
  // fall back to index.html via not_found_handling. See src/index.ts.
  "name": "journeys-web",
  "account_id": "1a27e1439dde2fa5249a1fe07b43b3f4",
  "compatibility_date": "2026-11-14",
  "main": "src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../dist",
    "base_path": "/app",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Run the Worker first only for hashed build files so a miss is a 404.
    // /app, /app/trace, and other app routes keep the SPA fallback.
    "run_worker_first": ["/app/assets/*"]
  },
  "routes": [
    {
      "pattern": "journeys.authentic.how/app*",
      "zone_name": "authentic.how"
    }
  ]
}
