<?xml version="1.0" encoding="utf-8"?>
<!-- Downloaded Bibles are re-downloadable; keep them out of cloud backup and device transfer (API 31+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="bibles"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="bibles"/>
    </device-transfer>
</data-extraction-rules>
